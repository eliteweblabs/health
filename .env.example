# =============================================================================
# health service environment variables
# =============================================================================
# Copy to .env for local dev, or set in Railway > Variables for prod.
# Detectors auto-fire from the env vars they care about — just set the ones
# for the services this instance should monitor.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# Bearer token required on every /api/* request. Pick a long random string.
HEALTHCHECK_TOKEN=

# ---- Optional: scheduling ---------------------------------------------------

# Internal tick (minutes). 0 disables internal cron (rely on external pings).
HEALTH_INTERVAL_MIN=10

# ---- Optional: alerting via Twilio SMS --------------------------------------
# All four must be set for SMS alerts to fire.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ALERT_PHONE_FROM=     # your Twilio number, E.164 e.g. +18889498224
ALERT_PHONE_TO=       # destination, E.164 e.g. +15551234567

# ---- Optional: alerting via Resend email ------------------------------------

RESEND_API_KEY=
ALERT_EMAIL=          # destination email
ALERT_EMAIL_FROM=health@yourdomain.com

# ---- Optional: Railway introspection ----------------------------------------
# When set, the railway detector lists every service in the project that has
# a public domain and adds a liveness check for each.
# Create at https://railway.app/account/tokens (account-scoped).

RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=   # auto-injected when running on Railway; set for local dev

# ---- Service detectors: set the vars for whatever you want monitored --------

# Vapi assistant reachability (needs the private key, not the public one).
VAPI_PRIVATE_KEY=
PUBLIC_VAPI_ASSISTANT_ID=

# Clerk credentials probe.
CLERK_SECRET_KEY=

# Supabase REST liveness.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres SELECT 1 probe.
DATABASE_URL=

# Resend API key validity probe (separate from the alerting key — usually
# the same value).
# RESEND_API_KEY (already set above)

# GitHub knowledge repo HEAD checks.
# Format: <slug>:<owner>/<repo>,<slug>:<owner>/<repo>
KNOWLEDGE_SERVICES=

# Arbitrary HTTP liveness targets.
# Format: <name>=<url>,<name>=<url>
# A 2xx or 3xx response counts as ok.
HEALTH_TARGETS=
